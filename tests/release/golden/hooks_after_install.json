{
  "_description": "Expected settings.json hook structure after memory-bank hooks install --on all",
  "required_events": ["Stop", "PreCompact", "UserPromptSubmit", "SessionStart"],
  "Stop": {
    "min_entries": 2,
    "must_contain": ["memory-bank ingest claude-code", "memory-bank distill"]
  },
  "PreCompact": {
    "min_entries": 1,
    "must_contain": ["memory-bank ingest claude-code", "# precompact"]
  },
  "UserPromptSubmit": {
    "min_entries": 1,
    "must_contain": ["memory-bank hooks recall"]
  },
  "SessionStart": {
    "min_entries": 1,
    "must_contain": ["memory-bank hooks context-summary"]
  }
}
